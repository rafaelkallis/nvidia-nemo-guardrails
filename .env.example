# ---------------------------------------------------------------------------
# Environment template for the self-hosted NeMo Guardrails stack.
# Copy to `.env` and adjust. Used by docker-compose.yml.
# ---------------------------------------------------------------------------

# Guardrails server host port (default 7331).
NEMO_HOST_PORT=7331

# vLLM model to serve when using `docker compose --profile full up`.
VLLM_MODEL=deepseek-ai/DeepSeek-V3
# Served model name that clients/guardrails will address. Must match
# `model:` in config/vllm-guard/config.yml.
VLLM_MODEL_NAME=deepseek-v3

# vLLM API key placeholder (vLLM typically unauthenticated).
# If auth is enabled, set this to a real token and use
# `api_key_env_var: OPENAI_API_KEY` in config.yml instead of `api_key: EMPTY`.
OPENAI_API_KEY=EMPTY

# Free-form notes (unused by the stack)
# NEMO_GUARDRAILS_TAG=v0.23.0
